#!/usr/bin/env bash
# ting pre-commit gate. Four hard rules, in cheapest-first order:
#   1. redaction    — no secret/credential/cookie material in staged additions
#   2. bash 3.2     — no bash-4 feature in a staged shell script (the portability floor)
#   3. syntax       — bash -n on the STAGED content of every staged shell script
#   4. no stand-ins — every file under tests/ is a .sh that runs a real command
# Plus: refuse a force-added tmp/ file (scratch is untracked by convention).
#
# This hook is itself held to the 3.2 floor: no declare -A, no mapfile, every
# array expansion guarded.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass (discouraged):   git commit --no-verify
set -euo pipefail

fail=0

# ---------------------------------------------------------------- 1. redaction
# Length-anchored so a bare prefix in this file cannot self-match.
patterns=(
  'ghp_[A-Za-z0-9]{36}'
  'gho_[A-Za-z0-9]{36}'
  'ghu_[A-Za-z0-9]{36}'
  'ghs_[A-Za-z0-9]{36}'
  'ghr_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{60,}'
  'AKIA[0-9A-Z]{16}'
  'AIza[0-9A-Za-z_-]{35}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  # ting-specific: a browser cookie export or a captured YouTube session. The
  # suite reads cookies from a live browser profile and must never carry one.
  'Netscape HTTP Cookie File'
  '__Secure-[13]PSID[[:space:]=]'
  'SAPISID[[:space:]=][A-Za-z0-9_/-]{20,}'
)

added="$(git diff --cached --no-color -U0 --diff-filter=ACM -- . ':(exclude).githooks/*' \
  | grep '^+' | grep -v '^+++' || true)"

hits=""
for p in "${patterns[@]}"; do
  if printf '%s\n' "$added" | grep -qE -e "$p"; then
    hits="${hits}  /${p}/"$'\n'
  fi
done

if [ -n "$hits" ]; then
  {
    echo ""
    echo "BLOCKED: staged changes appear to contain a secret / credential / cookie export."
    echo "Matched pattern(s):"
    printf '%s' "$hits"
    echo ""
    echo "Secrets live in ~/env-secrets/ — never in the repo. Cookies are read from a"
    echo "live browser profile at runtime and are never committed."
    echo "If this is a false positive: git commit --no-verify"
  } >&2
  fail=1
fi

# ------------------------------------------------------- 2./3. staged shell scripts
# A staged script is checked as STAGED, not as it sits in the worktree — a partial
# `git add -p` can stage something that only parses because of unstaged lines.
staged_sh=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    shell/*) staged_sh="${staged_sh}${f}"$'\n' ;;
    .githooks/*) staged_sh="${staged_sh}${f}"$'\n' ;;
    *.sh) staged_sh="${staged_sh}${f}"$'\n' ;;
  esac
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM)
EOF

# The bash-4 features the suite forbids (docs/ARCHITECTURE.md「可移植性契约」). Detected on ADDED
# lines only, so pre-existing text in an untouched region never blocks a commit.
bash4='declare -A|mapfile|readarray|\$\{[A-Za-z_][A-Za-z0-9_]*,,|\$\{[A-Za-z_][A-Za-z0-9_]*\^\^|&>>|\|&|\$\{[A-Za-z_][A-Za-z0-9_]*\[-1\]|\$\{!\w+@\}'

while IFS= read -r f; do
  [ -n "$f" ] || continue

  # The hooks themselves carry the detector pattern and prose about the rule, so they
  # are exempt from the bash-4 scan (same carve-out the redaction check makes) — they
  # still get the bash -n gate below.
  #
  # A WHOLE-LINE COMMENT is dropped before the scan, for the same reason and one step
  # further in: a script's own portability note names the forbidden forms, and a line that
  # starts with # cannot run one. Without this a file that merely CHANGES PATH — a rename,
  # where every line counts as added — is blocked by the sentence telling the next reader
  # what not to write. A bash-4 feature with a comment after it is still code, and is still
  # caught: only lines that are nothing but a comment are dropped.
  case "$f" in .githooks/*) leak="" ;; *)
    add="$(git diff --cached --no-color -U0 -- "$f" | grep '^+' | grep -v '^+++' |
      grep -vE '^\+[[:space:]]*#' || true)"
    leak="$(printf '%s\n' "$add" | grep -nE "$bash4" || true)" ;;
  esac
  if [ -n "$leak" ]; then
    {
      echo ""
      echo "BLOCKED: $f adds a bash-4 feature. The suite's floor is bash 3.2 (macOS system bash)."
      printf '%s\n' "$leak" | sed 's/^/    /'
      echo ""
      echo "See docs/ARCHITECTURE.md「可移植性契约」 for the portable form. If a feature genuinely needs"
      echo "bash 4+, assert ((BASH_VERSINFO[0] >= 4)) at the top — never hardcode an"
      echo "interpreter path."
    } >&2
    fail=1
  fi

  if ! git show ":$f" 2>/dev/null | /bin/bash -n 2>/tmp/ting-hook-syntax.$$; then
    {
      echo ""
      echo "BLOCKED: staged $f does not parse under /bin/bash -n:"
      sed 's/^/    /' "/tmp/ting-hook-syntax.$$"
    } >&2
    fail=1
  fi
  rm -f "/tmp/ting-hook-syntax.$$"
done <<EOF
$staged_sh
EOF

# --------------------------------------------------- tests/: no mocks, no stand-ins
# The testing rule is absolute (CLAUDE.md, "Reject a check when it"): tests/ holds shell
# suites that invoke real commands, and nothing that RUNS in place of a component. A file
# there that is not a .sh is how that rule was broken last time — a python JSON-IPC peer
# scripted to answer the way mpv would not. The path is the cheap half of the rule and the
# only half a hook can decide; the half about a `sleep` posing as a live pid, or a shim on
# PATH, stays with review, which is where CLAUDE.md says it lives.
stand_in="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^tests/' | grep -vE '\.sh$' || true)"
if [ -n "$stand_in" ]; then
  {
    echo ""
    echo "BLOCKED: a non-.sh file is staged under tests/:"
    printf '%s\n' "$stand_in" | sed 's/^/    /'
    echo ""
    echo "tests/ is functional shell only — every check invokes a real entry point and reads"
    echo "its real answer. No mock, no fake peer, no stub process, no shimmed binary. A claim"
    echo "that needs a real peer belongs in tests/playback.sh, where the real one runs; a"
    echo "claim no real dependency can be made to produce is coverage this suite does without."
  } >&2
  fail=1
fi

# ------------------------------------------------------------- tmp/ discipline
scratch="$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)tmp/' || true)"
if [ -n "$scratch" ]; then
  {
    echo ""
    echo "BLOCKED: a tmp/ file is staged (force-added past .gitignore):"
    printf '%s\n' "$scratch" | sed 's/^/    /'
    echo ""
    echo "tmp/ is scratch by convention. A rig that has earned a permanent place moves"
    echo "to tests/ with a docstring saying what it proves."
  } >&2
  fail=1
fi

exit $fail
