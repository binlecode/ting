#!/usr/bin/env bash
# ting pre-push gate. This is a solo repo whose working branch IS main (54 commits,
# zero merges), so it does NOT block a direct push to main the way actop's does —
# blocking the normal workflow would only teach --no-verify. It blocks the two things
# that are actually unrecoverable, and warns on the rest:
#
#   BLOCK  a non-fast-forward (force) push to main, and deleting main
#   BLOCK  a syntax error in any script under shell/ (the last gate before it is public)
#   WARN   pushing a v* tag (VERSION must match it; semver policy opens ARCH-cli-contract.md)
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

protected="main"
zero="0000000000000000000000000000000000000000"
fail=0
warn_tag=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/${protected}" ]; then
    if [ "$local_sha" = "$zero" ]; then
      {
        echo ""
        echo "BLOCKED: this push would DELETE '${protected}' on the remote."
      } >&2
      fail=1
    elif [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      {
        echo ""
        echo "BLOCKED: non-fast-forward push to '${protected}' (this is a force-push)."
        echo "Remote ${remote_sha} is not an ancestor of ${local_sha} — pushing would"
        echo "discard remote history. Rebase onto origin/${protected} and push again:"
        echo "    git fetch origin && git rebase origin/${protected}"
      } >&2
      fail=1
    fi
  fi
  case "$remote_ref" in
    refs/tags/v*) warn_tag=1 ;;
  esac
done

# Syntax gate on every script as it stands in the worktree. Cheap, and it is the
# check the whole suite's correctness rests on — there is no CI behind this push.
# Globbed, not listed: a hardcoded set of six names is a gate that silently stops covering
# the suite the day a seventh command lands. A shebang is what makes a file in shell/ a
# script (VERSION is data).
for f in shell/*; do
  [ -f "$f" ] || continue
  head -n 1 "$f" | grep -q '^#!' || continue
  if ! /bin/bash -n "$f" 2>/tmp/ting-push-syntax.$$; then
    {
      echo ""
      echo "BLOCKED: $f does not parse under /bin/bash -n:"
      sed 's/^/    /' "/tmp/ting-push-syntax.$$"
    } >&2
    fail=1
  fi
  rm -f "/tmp/ting-push-syntax.$$"
done

if [ $warn_tag -eq 1 ]; then
  ver="$(cat VERSION 2>/dev/null || true)"
  {
    echo ""
    echo "WARNING: pushing a v* tag. VERSION reads '${ver:-?}' — the tag"
    echo "must match it, and the version is declared in exactly that one place."
    echo "Proceeding…"
  } >&2
fi

exit $fail
